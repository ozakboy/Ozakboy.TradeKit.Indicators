<!--
  這裡刻意不用 <Project Sdk="Microsoft.NET.Sdk"> 的簡寫,改為手動 Import。
  簡寫形式會在專案內容之前就載入 Sdk.props(進而載入根目錄的 Directory.Build.props),
  屆時 IsTestProject 還沒設定,Directory.Build.props 中「測試專案」那一段條件不會成立,
  測試碼會被套上 TreatWarningsAsErrors 與 AnalysisLevel=latest-all。
  先設好屬性再 Import,根目錄的共用設定才能正確分辨這是測試專案。

  The Sdk attribute shorthand loads Sdk.props (and with it the root Directory.Build.props) before this
  file's own properties are set, so IsTestProject would still be empty and the test-project branch of
  Directory.Build.props would never apply. Setting the property first and importing explicitly is what
  lets the shared props recognise this as a test project.
-->
<Project>

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <AssemblyName>Ozakboy.TradeKit.Indicators.Tests</AssemblyName>
    <RootNamespace>Ozakboy.TradeKit.Indicators.Tests</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!--
      改用 MSTest 內建的 Microsoft.Testing.Platform 執行器,不走舊的 VSTest。
      理由是相依政策:VSTest 那條路徑會經由 Microsoft.TestPlatform.ObjectModel 遞移帶進
      Newtonsoft.Json —— 它掛在 Microsoft 的套件底下,但本身是第三方社群套件,
      而本專案的判定標準是遞移相依而非套件名稱。換成 MTP 之後整棵相依樹只剩 Microsoft.* 。
      Uses MSTest's built-in Microsoft.Testing.Platform runner instead of the legacy VSTest path.
      This is a dependency-policy decision: VSTest transitively drags in Newtonsoft.Json through
      Microsoft.TestPlatform.ObjectModel. It sits under a Microsoft package but is itself a third-party
      community library, and this project judges by the transitive graph rather than by package name.
    -->
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <OutputType>Exe</OutputType>

    <!--
      CA1707(識別字不得含底線)只在此測試專案關閉。
      測試方法採用業界通用的 Method_Scenario_ExpectedResult 命名,底線是刻意的分隔符號,
      失敗報告靠它才讀得懂;為了規避這條規則而改名,反而會犧牲測試的可讀性。
      產品專案(src)完全不受影響,仍維持零警告。
      CA1707 (no underscores in identifiers) is disabled for this test project only. Test methods use the
      conventional Method_Scenario_ExpectedResult naming where the underscores are deliberate separators
      that make failure reports readable. The product project keeps the rule and stays warning-free.
    -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <!--
    刻意不參照 MSTest 整合套件,而是直接點名它底下需要的部分。
    MSTest 整合套件會帶進 Microsoft.NET.Test.Sdk → Microsoft.TestPlatform.TestHost → Newtonsoft.Json,
    而 Newtonsoft.Json 是第三方社群套件,違反本專案「只用 BCL 與 Microsoft 官方套件」的相依政策
    (判定看遞移相依,不看套件名稱)。改為直接參照後,整棵相依樹只剩 Microsoft.* 與 System.*。
    覆蓋率改由 Microsoft.Testing.Extensions.CodeCoverage 提供,它不經過 VSTest 那條路徑。

    Deliberately avoids the MSTest metapackage and names the pieces it needs instead. The metapackage pulls
    Microsoft.NET.Test.Sdk -> Microsoft.TestPlatform.TestHost -> Newtonsoft.Json, and Newtonsoft.Json is a
    third-party community library, which this project's dependency policy forbids (the policy judges by the
    transitive graph, not by package name). Referencing directly leaves only Microsoft.* and System.* in the
    graph; coverage comes from Microsoft.Testing.Extensions.CodeCoverage, which bypasses VSTest.
  -->
  <ItemGroup>
    <PackageReference Include="MSTest.TestAdapter" Version="4.0.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.0.2" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.1.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ozakboy.TradeKit.Indicators\Ozakboy.TradeKit.Indicators.csproj" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

</Project>
